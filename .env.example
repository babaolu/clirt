# Neon Postgres connection string (use the pooled connection string)
DATABASE_URL=""

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Public base URL, e.g. http://localhost:5173 locally or https://your-app.vercel.app in production
BETTER_AUTH_URL="http://localhost:5173"

# Google OAuth (sign-in is disabled with a clear message if these are empty)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mailgun (used in a later phase)
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
# us or eu
MAILGUN_REGION="us"
# e.g. Clirt <postmaster@your-sandbox-domain.mailgun.org>
MAIL_FROM=""

# Pusher Channels (instant cart sync). Key and cluster are public; the secret is server-only.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""

# Trust Expo Go (exp://) origins for mobile sign-in outside local dev. Leave empty in production.
EXPO_DEV_ORIGINS=""
